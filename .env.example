# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# VITE_YOUTUBE_API_KEY: Required for fetching videos from YouTube Data API.
# AI Studio does NOT automatically inject VITE_ prefixed variables from secrets.
VITE_YOUTUBE_API_KEY="AIzaSyAVcFwICLuFPaRZERGL6M70dMBVp71v8DI"

